# Base URL of the Splitsy OCR backend (see server/), reachable from your phone
# on the same network as this machine during development, e.g.:
#   EXPO_PUBLIC_OCR_BACKEND_URL=http://192.168.1.10:8787
# Leave unset to skip the backend entirely and always use on-device ML Kit OCR.
EXPO_PUBLIC_OCR_BACKEND_URL=

# Base URL of the Splitsy auth backend (same server/ as above, Better Auth
# mounted at /api/auth/* — see server/src/auth.ts), reachable from your phone
# on the same network as this machine during development, e.g.:
#   EXPO_PUBLIC_AUTH_BACKEND_URL=http://192.168.1.10:8787
# Unlike EXPO_PUBLIC_OCR_BACKEND_URL, this has no offline fallback — signing
# in requires a network connection (2026-08-25 spec Amendment), and leaving
# this unset is a hard startup error, not a silent skip.
EXPO_PUBLIC_AUTH_BACKEND_URL=
