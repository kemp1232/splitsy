# Groq API key used for receipt transcription (https://console.groq.com/keys).
# Required — leave unset and every /api/ocr request fails fast with a clear
# error rather than an obscure 401 from Groq.
GROQ_API_KEY=

# Which vision engine to use for receipt transcription. Currently only
# "qwen3.6-27b" (Alibaba's Qwen 3.6 27B, multimodal, hosted on Groq) is wired
# up, but the config-switchable pattern (see server/src/ocr/engines.ts) is
# kept so adding another Groq vision model later is a config change, not a
# code change.
OCR_ENGINE=qwen3.6-27b

# Port this server listens on
PORT=8787

# Max width (px) the uploaded receipt image is downsized to before OCR —
# smaller means fewer image tokens (faster inference) at the cost of detail.
# Optional; defaults to 1280 if unset.
OCR_IMAGE_MAX_WIDTH=1280
