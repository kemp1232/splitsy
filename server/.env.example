# Groq API key used for receipt transcription (https://console.groq.com/keys).
# Required — leave unset and every /api/ocr request fails fast with a clear
# error rather than an obscure 401 from Groq.
GROQ_API_KEY=

# Which vision engine to use for receipt transcription. Currently only
# "qwen3.8-27b" (Alibaba's Qwen 3.8 27B, multimodal, hosted on Groq) is wired
# up, but the config-switchable pattern (see server/src/ocr/engines.ts) is
# kept so adding another Groq vision model later is a config change, not a
# code change.
OCR_ENGINE=qwen3.8-27b

# Port this server listens on
PORT=8787

# Max width (px) the uploaded receipt image is downsized to before OCR —
# smaller means fewer image tokens (faster inference) at the cost of detail.
# Optional; defaults to 1280 if unset.
OCR_IMAGE_MAX_WIDTH=1280

# Postgres connection string Better Auth stores users/sessions in — e.g. a
# Neon project's connection string (https://neon.tech), which also works
# fine for local dev (no local Postgres install needed). Required outside
# tests (vitest sets NODE_ENV=test automatically, which uses a throwaway
# in-memory SQLite database instead — see server/src/auth.ts). Run
# `npm run db:migrate` once against a fresh database before first use;
# idempotent, safe to re-run any time after that (e.g. after a deploy).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret Better Auth uses to sign sessions and tokens. Required — the server
# refuses to start without it. Generate your own with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# (or any equivalent random-hex generator) — do not reuse a value from
# another environment.
BETTER_AUTH_SECRET=

# This server's own externally-reachable base URL — Better Auth uses it to
# build links (e.g. the password-reset URL emailed to users). Required —
# the server refuses to start without it. localhost is only reachable from
# this same machine; a physical phone on the same network needs the
# machine's LAN IP instead (see EXPO_PUBLIC_OCR_BACKEND_URL in the project
# root .env.example for the same LAN-IP consideration on the client side).
BETTER_AUTH_URL=http://localhost:8787

# Resend API key used to actually send password-reset emails
# (https://resend.com/api-keys). Required for password reset — sign-up and
# sign-in work fine without it, but a reset-password request will fail with
# an email-send error until this is set.
RESEND_API_KEY=

# "From" address used for password-reset emails. Defaults to Resend's
# no-verification-needed sandbox sender, which is fine for local dev but
# will only deliver to your own Resend account's verified email address —
# switch to an address on a verified custom domain for real production
# sending.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Comma-separated list of origins the web build of the app is allowed to
# call this server from — used for both browser CORS *and* Better Auth's own
# separate server-side origin check (a request can pass CORS and still get
# rejected with "Invalid origin" without also being in Better Auth's
# trustedOrigins — see server/src/auth.ts). Native app requests are never
# subject to either check, so this only matters for the web port. Optional;
# defaults to this repo's two documented local web dev origins
# (http://localhost:8081 for `pnpm web`, http://localhost:3000 for
# `pnpm web:preview`). Add a deployed web app's real origin here once there
# is one.
WEB_APP_ORIGINS=http://localhost:8081,http://localhost:3000
