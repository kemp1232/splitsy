# Base URL of a running Ollama instance
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Which vision engine to use for receipt transcription:
# "qwen3-vl" (4b, default), "qwen3-vl-8b" (larger/slower, possibly more accurate),
# "minicpm-v" (smaller, OCR/document-specialized, candidate for handwriting), or "paddleocr-vl"
OCR_ENGINE=qwen3-vl

# Port this server listens on
PORT=8787

# Max width (px) the uploaded receipt image is downsized to before OCR —
# smaller means fewer image tokens (faster inference) at the cost of detail.
# Optional; defaults to 1280 if unset.
OCR_IMAGE_MAX_WIDTH=1280
